{
  "name": "md.studio",
  "short_name": "md.studio",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#F6F1E7",
  "theme_color": "#F6F1E7",
  "description": "Escribe y revisa documentos Markdown. Tus notas se guardan en este navegador.",
  "lang": "es",
  "icons": [
    {
      "src": "/assets/logo/md-studio-isotipo.png",
      "sizes": "768x768",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  }
}
