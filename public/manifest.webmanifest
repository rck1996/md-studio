{
  "name": "MarkEDdown Studio · Pocket",
  "short_name": "MarkEDdown",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#F1E4CF",
  "theme_color": "#071A2C",
  "description": "Escribe, organiza y conecta documentos Markdown. Tus archivos permanecen en tu dispositivo.",
  "lang": "es",
  "icons": [
    {
      "src": "/icons/markeddown-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/markeddown-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/assets/logo/markeddown-studio-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  }
}
